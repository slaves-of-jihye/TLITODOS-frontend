{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@repo/*": ["packages/*"],
      "@tlitodos/api-client": ["packages/api-client/src/index.ts"],
      "@tlitodos/core": ["packages/core/src/index.ts"],
      "@tlitodos/hooks": ["packages/hooks/src/index.ts"],
      "@tlitodos/types": ["packages/types/src/index.ts"],
      "@tlitodos/ui": ["packages/ui/src/index.ts"]
    }
  }
}
